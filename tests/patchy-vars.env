# The application's own contract: the patchy-vars ConfigMap the app modules
# publish through their vars output (modules/aws, modules/google). Sourced
# alongside each cloud's platform env so the strict-substitution check
# holds the manifests to exactly these two ConfigMaps. Every harness
# elected and the evaluation controller on, so the render covers the widest
# surface.
AGENT_HARNESSES=claude,codex,copilot
AGENT_EGRESS_POLICY=cilium
PATCHY_EVALUATION=true
PATCHY_DOMAIN=patchy.bitwisemedia.co.uk
CLAUDE_PROVIDER=anthropic
CLAUDE_ANTHROPIC_AUTH=token
CLAUDE_BEDROCK_REGION=
CLAUDE_BEDROCK_REGION_PREFIX=
CLAUDE_MODEL_MAP=anthropic/claude-sonnet-5=test-model
PATCHY_MANIFESTS_SEMVER="<1.0.0 >=0.1.0"
SIGNED_IDENTITY_PATCHY_MANIFESTS="^https://github\.com/bitwise-media-group/patchy-app-manifests/\.github/workflows/publish\.yaml@refs/tags/v.+$"
