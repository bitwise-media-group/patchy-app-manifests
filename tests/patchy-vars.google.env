# Overlay sourced ON TOP of patchy-vars.env for the google passes: the
# vertex provider pair the google app module publishes instead of the
# bedrock pair, and the SCC pipeline extras the google patchy root adds.
CLAUDE_BEDROCK_REGION=
CLAUDE_BEDROCK_REGION_PREFIX=
CLAUDE_VERTEX_REGION=
CLAUDE_VERTEX_PROJECT_ID=
AGENT_EGRESS_POLICY=auto
SCC_AUDIENCE=https://integrations.patchy.bitwisemedia.co.uk/google-cloud/webhooks
SCC_PUSH_SA=patchy-scc-push@ci-test-project.iam.gserviceaccount.com
SCC_ORGANIZATION=111111111111
SCC_ASSET_SCOPE=organizations/111111111111
SCC_ASSET_SA=patchy-assets@ci-test-foundation.iam.gserviceaccount.com
PATCHY_FALLBACK_REPOSITORY=bitwisemedia/security
