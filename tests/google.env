# The platform contract a google cluster publishes (terraform-google-gke-flux
# flux.tf reserved_cluster_vars, once it carries the 4.x platform keys):
# every reserved key, so the strict-substitution check catches a manifest
# reaching for a key the platform does not publish. Application-owned keys
# live in patchy-vars.env (plus the google-only extras in
# patchy-vars.google.env), sourced alongside. Vars the google module never
# publishes (the aws module's reserved set) are deliberately ABSENT.
CLUSTER_NAME=ci-test
GCP_PROJECT=ci-test-project
GCP_PROJECT_NUMBER=111111111111
GCP_REGION=us-central1
PLATFORM_REGISTRY=us-central1-docker.pkg.dev/ci-test-project/platform
CONTAINER_REGISTRY=us-central1-docker.pkg.dev/ci-test-project/platform
SIGNED_IDENTITY_ISSUER="^https://token\.actions\.githubusercontent\.com$"
SIGNED_IDENTITY_CHARTS="^https://github\.com/bitwise-media-group/flux-containers/\.github/workflows/publish\.yaml@refs/heads/main$"
SIGNED_IDENTITY_IMAGES="^https://github\.com/bitwise-media-group/flux-containers/\.github/workflows/publish\.yaml@refs/heads/main$"
SIGNED_IDENTITY_MANIFESTS="^https://github\.com/bitwise-media-group/flux-manifests/\.github/workflows/publish\.yaml@refs/heads/main$"
SIGNED_IDENTITY_KMS_KEY=
COSIGN_PUBLIC_KEY=
FLUX_SYNC_CHANNEL=edge
FLUX_SYNC_URL=oci://us-central1-docker.pkg.dev/ci-test-project/platform/manifests/platform
PLATFORM_TREE=google
PLATFORM_COMPONENTS=dex,flux-web
PLATFORM_DOMAIN=patchy.bitwisemedia.co.uk
DEX_CLIENTS='[{"id":"flux-web","name":"Flux Status","public":false,"redirectURIs":["https://flux.patchy.bitwisemedia.co.uk/oauth2/callback"]}]'
DNS_ZONE_NAME=patchy-bitwisemedia-co-uk
DNS_DOMAIN=patchy.bitwisemedia.co.uk
ACME_EMAIL=platform@bitwisemedia.co.uk
GATEWAY_ADDRESS_NAME=patchy-x-gateway
GATEWAY_IP=203.0.113.10
OTEL_PROJECT=ci-test-project
SECRET_PREFIX=ci-test-
RBAC_GROUP_VIEWERS=gcp-ci-test-viewers@bitwisemedia.co.uk
RBAC_GROUP_DEVELOPERS=gcp-ci-test-developers@bitwisemedia.co.uk
RBAC_GROUP_DEVOPS=gcp-ci-test-devops@bitwisemedia.co.uk
RBAC_GROUP_ADMINS=gcp-ci-test-admins@bitwisemedia.co.uk
DEX_DIRECTORY_SA=dex-directory@ci-test-project.iam.gserviceaccount.com
DEX_CONNECTORS='[{"id":"google","type":"google","name":"Google","secrets":["client-id","client-secret","admin-email"],"config":{"clientID":"$GOOGLE_CLIENT_ID","clientSecret":"$GOOGLE_CLIENT_SECRET","adminEmail":"$GOOGLE_ADMIN_EMAIL","fetchTransitiveGroupMembership":true,"redirectURI":"https://dex.patchy.bitwisemedia.co.uk/callback"}}]'
