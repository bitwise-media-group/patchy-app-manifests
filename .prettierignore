# Repo-local copy of the toolchain house default (.mise/.prettierignore) plus
# the terraform-docs surface: prettier reflows the generated BEGIN_TF_DOCS
# blocks, which terraform-docs then regenerates - the two generators cannot
# both own those files.
modules/*/README.md

# generated by release-please; its release PRs must not trip the format gate
CHANGELOG.md

# vendored / machine-managed trees
node_modules/
.mise/
.venv/

# agent cruft
.claude/

# docs site build output
site/
.cache/
